                e.target.reset();
            };

            if(fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = (evt) => saveQ(evt.target.result);
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                saveQ();
            }
        }

        function renderGuruQuizList() {
            const container = document.getElementById('container-guru-quiz-list');
            container.innerHTML = '';
            appState.bankSoal.forEach((q, idx) => {
                container.innerHTML += `
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 flex justify-between items-start gap-4">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-slate-800">${idx+1}. ${q.question}</p>
                            ${q.image ? `<img src="${q.image}" class="h-16 rounded object-contain">` : ''}
                        </div>
                        <button onclick="deleteQuizQuestion(${idx})" class="text-red-500 hover:text-red-700 text-xs"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            });
        }
        function deleteQuizQuestion(idx) {
            appState.bankSoal.splice(idx, 1);
            saveState(); renderGuruQuizList();
        }

        // Calendar & ToDos
        function renderCalendar() {
            const container = document.getElementById('calendar-days-container');
            container.innerHTML = '';
            for(let i=1; i<=31; i++) {
                const day = document.createElement('div');
                day.className = "py-2 rounded-xl text-center font-medium hover:bg-slate-100 transition-all cursor-pointer relative";
                day.innerText = i;
                if(i === 22) day.className += " bg-blue-600 text-white font-bold shadow-md";
                container.appendChild(day);
            }
        }

        function renderTodos() {
            const container = document.getElementById('todo-list-container');
            container.innerHTML = '';
            appState.todos.forEach((todo, idx) => {
                container.innerHTML += `
                    <div class="flex items-center justify-between group">
                        <label class="flex items-center gap-3 cursor-pointer select-none ${todo.done ? 'line-through text-slate-400' : ''}">
                            <input type="checkbox" ${todo.done ? 'checked' : ''} onchange="toggleTodo(${idx})" class="w-5 h-5 rounded text-brand-orange border-slate-300">
                            <span>${todo.text}</span>
                        </label>
                        <button onclick="deleteTodo(${idx})" class="text-slate-300 hover:text-red-500 text-xs opacity-0 group-hover:opacity-100"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            });
        }
        function toggleTodo(idx) { appState.todos[idx].done = !appState.todos[idx].done; saveState(); renderTodos(); }
        function addTodoItem() {
            const text = prompt("Masukkan agenda guru baru:");
            if(text) { appState.todos.push({ id: Date.now(), text: `${appState.todos.length + 1}. ${text}`, done: false }); saveState(); renderTodos(); }
        }
        function deleteTodo(idx) { appState.todos.splice(idx, 1); saveState(); renderTodos(); }

        // Live Bar Chart Guru
        function initQuizChart() {
            const ctx = document.getElementById('quizScoresChart')?.getContext('2d');
            if(!ctx) return;
            if(quizBarChartObj) quizBarChartObj.destroy();

            const labels = appState.quizScores.map(s => s.name);
            const data = appState.quizScores.map(s => s.score);

            quizBarChartObj = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Skor Kuis Real-Time',
                        data: data,
                        backgroundColor: '#3B82F6',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    scales: { y: { beginAtZero: true, max: 100 } }
                }
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            showView('view-landing');
        });
    </script>
</body>
</html>
