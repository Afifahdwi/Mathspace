        // Interactive Cartesian Simulation
        function initCartesianCanvas() {
            const canvas = document.getElementById('cartesianCanvas');
            if(!canvas) return;
            const ctx = canvas.getContext('2d');
            
            drawCartesianGrid(ctx, canvas.width, canvas.height);

            canvas.onclick = function(e) {
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const clickX = (e.clientX - rect.left) * scaleX;
                const clickY = (e.clientY - rect.top) * scaleY;

                const gridCenterX = canvas.width / 2;
                const gridCenterY = canvas.height / 2;
                const step = 20;

                const cartX = Math.round((clickX - gridCenterX) / step);
                const cartY = Math.round((gridCenterY - clickY) / step);

                cartesianPoints.push({ x: cartX, y: cartY, cx: gridCenterX + cartX * step, cy: gridCenterY - cartY * step });
                drawCartesianPoints();
            };
        }

        function drawCartesianGrid(ctx, width, height) {
            ctx.clearRect(0, 0, width, height);
            ctx.strokeStyle = '#334155';
            ctx.lineWidth = 1;

            const step = 20;
            for(let x = 0; x <= width; x += step) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
            }
            for(let y = 0; y <= height; y += step) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
            }

            // Axis Lines
            ctx.strokeStyle = '#60A5FA';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(width/2, 0); ctx.lineTo(width/2, height);
            ctx.moveTo(0, height/2); ctx.lineTo(width, height/2);
            ctx.stroke();

            // Axis Labels
            ctx.fillStyle = '#94A3B8';
            ctx.font = '10px sans-serif';
            ctx.fillText('X', width - 15, height/2 - 5);
            ctx.fillText('Y', width/2 + 5, 12);
        }

        function drawCartesianPoints() {
            const canvas = document.getElementById('cartesianCanvas');
            const ctx = canvas.getContext('2d');
            drawCartesianGrid(ctx, canvas.width, canvas.height);

            // Polygon Lines
            if(cartesianPoints.length > 1) {
                ctx.strokeStyle = '#EF4444';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(cartesianPoints[0].cx, cartesianPoints[0].cy);
                for(let i=1; i<cartesianPoints.length; i++) {
                    ctx.lineTo(cartesianPoints[i].cx, cartesianPoints[i].cy);
                }
                ctx.closePath();
                ctx.stroke();
                ctx.fillStyle = 'rgba(239, 68, 68, 0.2)';
                ctx.fill();
            }

            // Draw Original Points
            cartesianPoints.forEach((p, i) => {
                ctx.fillStyle = '#EF4444';
                ctx.beginPath(); ctx.arc(p.cx, p.cy, 5, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#FFFFFF';
                ctx.font = '11px sans-serif';
                ctx.fillText(`P${i+1}(${p.x},${p.y})`, p.cx + 6, p.cy - 6);
            });

            updateCartesianPointsList();
        }

        function animateTranslation() {
            if(cartesianPoints.length === 0) {
                alert("Klik titik pada grid terlebih dahulu!");
                return;
            }
            const shiftA = parseInt(document.getElementById('shift-a').value) || 0;
            const shiftB = parseInt(document.getElementById('shift-b').value) || 0;

            const canvas = document.getElementById('cartesianCanvas');
            const ctx = canvas.getContext('2d');
            drawCartesianPoints();

            // Draw Translated Object
            const step = 20;
            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;

            ctx.strokeStyle = '#00A86B';
            ctx.lineWidth = 2;
            ctx.beginPath();
            cartesianPoints.forEach((p, i) => {
                const tx = p.x + shiftA;
                const ty = p.y + shiftB;
                const tcx = centerX + tx * step;
                const tcy = centerY - ty * step;

                if(i===0) ctx.moveTo(tcx, tcy); else ctx.lineTo(tcx, tcy);
            });
            ctx.closePath();
            ctx.stroke();
            ctx.fillStyle = 'rgba(0, 168, 107, 0.3)';
            ctx.fill();

            cartesianPoints.forEach((p, i) => {
                const tx = p.x + shiftA;
                const ty = p.y + shiftB;
                const tcx = centerX + tx * step;
                const tcy = centerY - ty * step;

                ctx.fillStyle = '#00A86B';
                ctx.beginPath(); ctx.arc(tcx, tcy, 5, 0, Math.PI * 2); ctx.fill();
                ctx.fillStyle = '#00A86B';
                ctx.font = 'bold 11px sans-serif';
                ctx.fillText(`P${i+1}'(${tx},${ty})`, tcx + 6, tcy + 15);
            });
        }

        function clearCanvasPoints() {
            cartesianPoints = [];
            const canvas = document.getElementById('cartesianCanvas');
            if(canvas) drawCartesianGrid(canvas.getContext('2d'), canvas.width, canvas.height);
