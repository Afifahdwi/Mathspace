                                        <div>
                                            <label class="block text-[11px] font-bold text-slate-600 mb-1">Pergeseran Y (b)</label>
                                            <input type="number" id="shift-b" value="2" class="w-full px-3 py-2 border border-slate-200 rounded-xl font-mono text-center font-bold text-sm">
