                    <button type="submit" class="w-full py-3.5 bg-brand-orange hover:bg-orange-600 text-white font-bold rounded-xl shadow-md transition-all">
                        Mulai Belajar Sekarang <i class="fa-solid fa-arrow-right ml-1.5"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Modal Login Guru (PIN: 262626) -->
